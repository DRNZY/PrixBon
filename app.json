{
  "expo": {
    "name": "PrixBon",
    "slug": "PrixBon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drnzy000.PrixBon",
      "infoPlist": {
        "NSCameraUsageDescription": "PrixBon gebruikt de camera om bonnetjes te scannen en lokaal op te slaan."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f1a"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.drnzy000.PrixBon",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "PrixBon gebruikt de camera om bonnetjes te scannen en lokaal op te slaan."
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95669402-e063-40a9-b960-895f7fcc1b8b"
      }
    }
  }
}
